{
 "formatVersion": "0.10",
 "id": "gauge-abacus",
 "version": "0.1.0",
 "name": "Gauge: abacus",
 "description": "An abacus gauge: amber beads pushed right count a value from 0 to 100, a white halo collar its running average.",
 "category": "machines",
 "tags": [
  "gauge",
  "meter",
  "percent",
  "abacus",
  "average"
 ],
 "scene": "object.gltf",
 "license": "CC-BY-4.0",
 "attribution": [
  {
   "path": ".",
   "author": "Hyprune contributors",
   "license": "CC-BY-4.0",
   "source": "https://github.com/hyprune/worlds"
  },
  {
   "path": "build.py",
   "author": "Hyprune contributors",
   "license": "MIT",
   "source": "https://github.com/hyprune/worlds"
  }
 ],
 "thumbnail": "thumbnail.png",
 "lighting": {
  "mode": "probe"
 },
 "traits": {
  "collidable": {
   "node": "proxy"
  },
  "movable": {
   "surfaces": [
    "floor"
   ],
   "upright": true
  },
  "machine": {
   "primary": "level",
   "inputs": [
    {
     "id": "value",
     "type": "number",
     "min": 0,
     "max": 100,
     "default": 0,
     "label": "Value",
     "explain": "Amber beads pushed to the right, one per unit, filling rod by rod from the bottom; ivory beads on the left make up the hundred."
    },
    {
     "id": "display",
     "type": "text",
     "maxLength": 12,
     "label": "Display",
     "explain": "The large text on the plate, as the source formats it (for example 71% or 12.3 GB)."
    },
    {
     "id": "label",
     "type": "text",
     "maxLength": 16,
     "label": "Label",
     "explain": "What the gauge measures, on the plate above the display (for example RAM)."
    },
    {
     "id": "level",
     "type": "enum",
     "values": [
      "ok",
      "warn",
      "fail"
     ],
     "default": "ok",
     "label": "Level",
     "explain": "The pushed beads' colour: amber when ok, orange on warn, red on fail; grey while the data is stale."
    },
    {
     "id": "average",
     "type": "number",
     "min": 0,
     "max": 100,
     "label": "Average (optional)",
     "explain": "A running average the source computes itself. Without it the halo shows the average of Value over the last minute."
    }
   ],
   "drives": [
    {
     "input": "value",
     "target": "count:pushed",
     "map": {
      "scale": {
       "from": [
        0,
        100
       ],
       "to": [
        0,
        100
       ]
      },
      "round": "floor"
     }
    },
    {
     "input": "value",
     "target": "count:rest",
     "map": {
      "scale": {
       "from": [
        0,
        100
       ],
       "to": [
        100,
        0
       ]
      },
      "round": "ceil"
     }
    },
    {
     "input": "level",
     "target": "state:fill"
    },
    {
     "input": "label",
     "target": "label:label"
    },
    {
     "input": "display",
     "target": "label:display"
    },
    {
     "input": "value",
     "target": "level:average-ring",
     "map": {
      "average": {
       "windowS": 60,
       "override": "average"
      },
      "scale": {
       "from": [
        0,
        100
       ],
       "to": [
        0,
        1
       ]
      }
     }
    }
   ]
  }
 },
 "slots": {
  "states": [
   {
    "id": "fill",
    "materials": [
     "fill"
    ],
    "palette": [
     {
      "id": "ok",
      "colour": [
       1.0,
       0.182,
       0.075
      ],
      "emission": 0.08
     },
     {
      "id": "warn",
      "colour": [
       1.0,
       0.07,
       0.03
      ],
      "emission": 0.12
     },
     {
      "id": "fail",
      "colour": [
       0.8,
       0.015,
       0.015
      ],
      "emission": 0.3
     },
     {
      "id": "stale",
      "colour": [
       0.35,
       0.33,
       0.3
      ],
      "emission": 0.05
     }
    ]
   }
  ],
  "labels": [
   {
    "id": "label",
    "pose": {
     "position": [
      0,
      0.2108,
      0.1896
     ],
     "rotation": [
      -0.13053,
      0,
      0,
      0.99144
     ]
    },
    "size": [
     0.36,
     0.095
    ],
    "maxChars": 16,
    "font": "mono",
    "colour": [
     0.8,
     0.75,
     0.6
    ]
   },
   {
    "id": "display",
    "pose": {
     "position": [
      0,
      0.0925,
      0.2213
     ],
     "rotation": [
      -0.13053,
      0,
      0,
      0.99144
     ]
    },
    "size": [
     0.36,
     0.14
    ],
    "maxChars": 12,
    "font": "mono",
    "colour": [
     1.0,
     0.8,
     0.42
    ]
   }
  ],
  "stacks": [
   {
    "id": "pushed",
    "node": "bead-pushed",
    "cap": 100,
    "rate": 40,
    "layout": {
     "grid": [
      10,
      10,
      1
     ],
     "spacing": [
      -0.05,
      0.075,
      0
     ],
     "fill": "xyz"
    }
   },
   {
    "id": "rest",
    "node": "bead-rest",
    "cap": 100,
    "rate": 40,
    "layout": {
     "grid": [
      10,
      10,
      1
     ],
     "spacing": [
      0.05,
      -0.075,
      0
     ],
     "fill": "xyz"
    }
   }
  ],
  "levels": [
   {
    "id": "average-ring",
    "node": "average-ring",
    "mode": "slide",
    "axis": [
     0.0,
     1.0,
     0.0
    ],
    "length": 0.75
   }
  ]
 },
 "bounds": {
  "min": [
   -0.56,
   0.0,
   -0.2396
  ],
  "max": [
   0.56,
   1.202,
   0.2396
  ]
 }
}
