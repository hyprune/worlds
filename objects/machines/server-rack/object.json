     "values": [
      "off",
      "ok",
      "warn",
      "fail"
     ],
     "default": "off",
     "repeat": 8,
     "label": "Unit health",
     "explain": "Units 1-8 from the bottom: each light bar shows its host (dark = no data or off)."
    },
    {
     "id": "load",
     "type": "number",
     "min": 0,
     "max": 1,
     "default": 0,
     "label": "Load",
     "explain": "Fan speed: the fans idle slowly at no load and race at full load."
    },
    {
     "id": "name",
     "type": "text",
     "maxLength": 20,
     "label": "Rack name",
     "explain": "The plate above the units."
    }
