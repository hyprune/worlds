{
 "formatVersion": "0.10",
 "id": "queue-stack",
 "version": "0.1.0",
 "name": "Queue stack",
 "description": "A queue as crates on a shelf rack: one crate per ten items, a depth counter, and a lantern, stripe and flag for the oldest item.",
 "category": "machines",
 "tags": [
  "queue",
  "backlog",
  "jobs",
  "crates"
 ],
 "scene": "object.gltf",
 "license": "CC-BY-4.0",
 "attribution": [
  {
   "path": ".",
   "author": "Hyprune contributors",
   "license": "CC-BY-4.0",
   "source": "https://github.com/hyprune/worlds"
  },
  {
   "path": "build.py",
   "author": "Hyprune contributors",
   "license": "MIT",
   "source": "https://github.com/hyprune/worlds"
  }
 ],
 "thumbnail": "thumbnail.png",
 "lighting": {
  "mode": "probe"
 },
 "traits": {
  "collidable": {
   "node": "proxy"
  },
  "movable": {
   "surfaces": [
    "floor"
   ],
   "upright": true
  },
  "machine": {
   "primary": "level",
   "inputs": [
    {
     "id": "depth",
     "type": "int",
     "min": 0,
     "max": 500,
     "default": 0,
     "label": "Queue depth",
     "explain": "Crates on the rack, one per ten queued items (48 crates = 480+); the header shows the exact number."
    },
    {
     "id": "level",
     "type": "enum",
     "values": [
      "ok",
      "warn",
      "fail"
     ],
     "default": "ok",
     "label": "Oldest item",
     "explain": "How long the oldest item has waited: the lantern and stripe turn amber, then red, and the red flag rises."
    },
    {
     "id": "name",
     "type": "text",
     "maxLength": 24,
     "label": "Queue name",
     "explain": "The plate on the plinth."
    }
   ],
   "drives": [
    {
     "input": "depth",
     "target": "count:crates",
     "map": {
      "scale": {
       "from": [
        0,
        480
       ],
       "to": [
        0,
        48
       ]
      },
      "clamp": true,
      "round": "ceil"
     }
    },
    {
     "input": "depth",
     "target": "label:label-count",
     "map": {
      "format": {
       "decimals": 0,
       "compact": true
      }
     }
    },
    {
     "input": "level",
     "target": "state:level"
    },
    {
     "input": "level",
     "target": "visible:alarm-flag",
     "map": {
      "cases": [
       {
        "equals": "ok",
        "to": false
       }
      ],
      "else": true
     }
    },
    {
     "input": "name",
     "target": "label:label-name"
    }
   ],
   "recipes": [
    {
     "name": "Queue stats JSON",
     "fields": {
      "depth": "/depth",
      "level": "/oldest_age_seconds",
      "name": "/name"
     },
     "maps": {
      "level": {
       "thresholds": [
        {
         "below": 300,
         "to": "ok"
        },
        {
         "below": 1800,
         "to": "warn"
        }
       ],
       "else": "fail"
      }
     }
    }
   ]
  }
 },
 "slots": {
  "states": [
   {
    "id": "level",
    "materials": [
     "level-lamp",
     "level-stripe"
    ],
    "palette": [
     {
      "id": "ok",
      "colour": [
       0.2,
       0.85,
       0.35
      ],
      "emission": 1.3
     },
     {
      "id": "warn",
      "colour": [
       1.0,
       0.42,
       0.085
      ],
      "emission": 1.8
     },
     {
      "id": "fail",
      "colour": [
       0.9,
       0.06,
       0.02
      ],
      "emission": 2.2
     }
    ]
   }
  ],
  "labels": [
   {
    "id": "label-count",
    "pose": {
     "position": [
      0,
      2.55,
      0.227
     ],
     "rotation": [
      0,
      0,
      0,
      1
     ]
    },
    "size": [
     1.06,
     0.3
    ],
    "maxChars": 12,
    "font": "mono"
   },
   {
    "id": "label-name",
    "pose": {
     "position": [
      0,
      0.09,
      0.901
     ],
     "rotation": [
      0,
      0,
      0,
      1
     ]
    },
    "size": [
     1.2,
     0.09
    ],
    "maxChars": 24,
    "font": "mono"
   }
  ],
  "stacks": [
   {
    "id": "crates",
    "node": "crate",
    "cap": 48,
    "layout": {
     "grid": [
      4,
      4,
      3
     ],
     "spacing": [
      0.46,
      0.5,
      0.46
     ],
     "fill": "xzy"
    }
   }
  ],
  "toggles": [
   {
    "id": "alarm-flag",
    "nodes": [
     "alarm-flag"
    ]
   }
  ]
 },
 "bounds": {
  "min": [
   -1.25,
   0.0,
   -0.905
  ],
  "max": [
   1.25,
   2.92,
   0.905
  ]
 }
}
