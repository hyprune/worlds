{
 "formatVersion": "0.11",
 "id": "build-monitor",
 "version": "0.1.0",
 "name": "Build monitor",
 "description": "A desk-height build totem: a glowing face with a state glyph, a halo that turns while building, and a burst on success.",
 "category": "machines",
 "tags": [
  "build",
  "ci",
  "status",
  "monitor"
 ],
 "scene": "object.gltf",
 "license": "CC-BY-4.0",
 "attribution": [
  {
   "path": ".",
   "author": "Hyprune contributors",
   "license": "CC-BY-4.0",
   "source": "https://github.com/hyprune/worlds"
  },
  {
   "path": "build.py",
   "author": "Hyprune contributors",
   "license": "MIT",
   "source": "https://github.com/hyprune/worlds"
  }
 ],
 "thumbnail": "thumbnail.png",
 "lighting": {
  "mode": "probe"
 },
 "traits": {
  "decorative": {
   "animations": [
    {
     "node": "ring",
     "type": "spin",
     "axis": [
      0.0,
      0.0,
      -1.0
     ],
     "pivot": [
      -0.00381,
      1.18,
      -0.0
     ],
     "period": 6
    }
   ]
  },
  "collidable": {
   "node": "proxy"
  },
  "movable": {
   "surfaces": [
    "floor"
   ],
   "upright": true
  },
  "machine": {
   "primary": "status",
   "inputs": [
    {
     "id": "status",
     "type": "enum",
     "values": [
      "idle",
      "running",
      "ok",
      "fail"
     ],
     "default": "idle",
     "label": "Build status",
     "explain": "The face colour and glyph: three dots while running, a tick when it passes, a cross when it fails. The halo turns while running."
    },
    {
     "id": "progress",
     "type": "number",
     "min": 0,
     "max": 1,
     "default": 0,
     "label": "Progress",
     "explain": "How bright the halo arcs glow."
    },
    {
     "id": "succeeded",
     "type": "event",
     "label": "Build succeeded",
     "explain": "A burst above the head (also when the status becomes ok after running)."
    }
   ],
   "drives": [
    {
     "input": "status",
     "target": "state:face"
    },
    {
     "input": "status",
     "target": "state:ring-glow"
    },
    {
     "input": "progress",
     "target": "emission:ring-glow",
     "map": {
      "scale": {
       "from": [
        0,
        1
       ],
       "to": [
        0.35,
        1.6
       ]
      },
      "clamp": true
     }
    },
    {
     "input": "status",
     "target": "animation:ring",
     "map": {
      "cases": [
       {
        "equals": "running",
        "to": 1
       }
      ],
      "else": 0
     }
    },
    {
     "input": "status",
     "target": "visible:glyph-ok",
     "map": {
      "cases": [
       {
        "equals": "ok",
        "to": true
       }
      ],
      "else": false
     }
    },
    {
     "input": "status",
     "target": "visible:glyph-fail",
     "map": {
      "cases": [
       {
        "equals": "fail",
        "to": true
       }
      ],
      "else": false
     }
    },
    {
     "input": "status",
     "target": "visible:glyph-run",
     "map": {
      "cases": [
       {
        "equals": "running",
        "to": true
       }
      ],
      "else": false
     }
    },
    {
     "input": "succeeded",
     "target": "effect:burst-fx"
    },
    {
     "input": "status",
     "target": "effect:burst-fx",
     "map": {
      "becomes": "ok",
      "from": "running"
     }
    }
   ],
   "recipes": [
    {
     "name": "Latest build JSON",
     "fields": {
      "status": "/builds/0/status",
      "progress": "/builds/0/progress",
      "succeeded": "/counters/succeeded"
     }
    }
   ]
  }
 },
 "slots": {
  "states": [
   {
    "id": "face",
    "materials": [
     "face"
    ],
    "palette": [
     {
      "id": "idle",
      "colour": [
       0.16,
       0.2,
       0.24
      ],
      "emission": 0.35
     },
     {
      "id": "running",
      "colour": [
       0.11,
       0.48,
       0.68
      ],
      "emission": 1.2
     },
     {
      "id": "ok",
      "colour": [
       0.2,
       0.85,
       0.35
      ],
      "emission": 1.1
     },
     {
      "id": "fail",
      "colour": [
       0.9,
       0.06,
       0.02
      ],
      "emission": 1.4
     }
    ]
   },
   {
    "id": "ring-glow",
    "materials": [
     "ring-glow"
    ],
    "palette": [
     {
      "id": "idle",
      "colour": [
       0.16,
       0.2,
       0.24
      ],
      "emission": 0.4
     },
     {
      "id": "running",
      "colour": [
       0.11,
       0.48,
       0.68
      ],
      "emission": 2.0
     },
     {
      "id": "ok",
      "colour": [
       0.2,
       0.85,
       0.35
      ],
      "emission": 1.8
     },
     {
      "id": "fail",
      "colour": [
       0.9,
       0.06,
       0.02
      ],
      "emission": 2.2
     }
    ]
   }
  ],
  "effects": [
   {
    "id": "burst-fx",
    "pose": {
     "position": [
      -0.0038,
      2,
      0
     ],
     "rotation": [
      0,
      0,
      0,
      1
     ]
    },
    "kind": "burst",
    "colour": [
     0.2,
     0.85,
     0.35
    ],
    "durationMs": 1500
   }
  ],
  "toggles": [
   {
    "id": "glyph-ok",
    "nodes": [
     "glyph-ok"
    ]
   },
   {
    "id": "glyph-fail",
    "nodes": [
     "glyph-fail"
    ]
   },
   {
    "id": "glyph-run",
    "nodes": [
     "glyph-run"
    ]
   }
  ]
 },
 "bounds": {
  "min": [
   -0.5538,
   0.0,
   -0.405
  ],
  "max": [
   0.5538,
   1.73,
   0.405
  ]
 }
}
