{
 "formatVersion": "0.11",
 "id": "ci-conveyor",
 "version": "0.1.0",
 "name": "CI conveyor",
 "description": "A CI pipeline as a conveyor: jobs drop from a hopper, pass four lit stations (build, test, package, deploy) and land in the output or the reject bin.",
 "category": "machines",
 "tags": [
  "ci",
  "pipeline",
  "jobs",
  "build"
 ],
 "scene": "object.gltf",
 "license": "CC-BY-4.0",
 "attribution": [
  {
   "path": ".",
   "author": "Hyprune contributors",
   "license": "CC-BY-4.0",
   "source": "https://github.com/hyprune/worlds"
  },
  {
   "path": "build.py",
   "author": "Hyprune contributors",
   "license": "MIT",
   "source": "https://github.com/hyprune/worlds"
  }
 ],
 "thumbnail": "thumbnail.png",
 "lighting": {
  "mode": "probe"
 },
 "traits": {
  "decorative": {
   "animations": [
    {
     "node": "stage-1-spinner",
     "type": "spin",
     "axis": [
      0.0,
      0.0,
      -1.0
     ],
     "pivot": [
      -1.175,
      1.75,
      0.375
     ],
     "period": 2.4
    },
    {
     "node": "stage-2-spinner",
     "type": "spin",
     "axis": [
      0.0,
      0.0,
      -1.0
     ],
     "pivot": [
      -0.075,
      1.75,
      0.375
     ],
     "period": 2.4,
     "phase": 0.17
    },
    {
     "node": "stage-3-spinner",
     "type": "spin",
     "axis": [
      0.0,
      0.0,
      -1.0
     ],
     "pivot": [
      1.025,
      1.75,
      0.375
     ],
     "period": 2.4,
     "phase": 0.34
    },
    {
     "node": "stage-4-spinner",
     "type": "spin",
     "axis": [
      0.0,
      0.0,
      -1.0
     ],
     "pivot": [
      2.125,
      1.75,
      0.375
     ],
     "period": 2.4,
     "phase": 0.51
    }
   ]
  },
  "collidable": {
   "node": "proxy"
  },
  "movable": {
   "surfaces": [
    "floor"
   ],
   "upright": true
  },
  "machine": {
   "primary": "stage",
   "inputs": [
    {
     "id": "stage",
     "type": "enum",
     "values": [
      "idle",
      "running",
      "ok",
      "fail"
     ],
     "default": "idle",
     "repeat": 4,
     "label": "Stage status",
     "explain": "Stations 1-4 (build, test, package, deploy): the lamp shows the stage state and its gears turn while it runs."
    },
    {
     "id": "jobStarted",
     "type": "event",
     "label": "Job started",
     "explain": "Each started job drops a crate from the hopper onto the belt."
    },
    {
     "id": "jobPassed",
     "type": "event",
     "label": "Job passed",
     "explain": "A passed job lands in the output bin with a burst."
    },
    {
     "id": "jobFailed",
     "type": "event",
     "label": "Job failed",
     "explain": "A failed job is pushed into the reject bin under the red flag."
    },
    {
     "id": "progress",
     "type": "number",
     "min": 0,
     "max": 1,
     "default": 0,
     "label": "Progress",
     "explain": "The pip rail along the belt: one pip per tenth of the pipeline."
    },
    {
     "id": "queued",
     "type": "int",
     "min": 0,
     "max": 18,
     "default": 0,
     "label": "Queued jobs",
     "explain": "Crates waiting on the pallet beside the hopper, one per queued job."
    },
    {
     "id": "pipeline",
     "type": "text",
     "maxLength": 24,
     "label": "Pipeline name",
     "explain": "The board above the hopper."
    }
   ],
   "drives": [
    {
     "input": "stage.1",
     "target": "state:stage-1-lamp"
    },
    {
     "input": "stage.1",
     "target": "animation:stage-1-spinner",
     "map": {
      "cases": [
       {
        "equals": "running",
        "to": 1
       }
      ],
      "else": 0
     }
    },
    {
     "input": "stage.2",
     "target": "state:stage-2-lamp"
    },
    {
     "input": "stage.2",
     "target": "animation:stage-2-spinner",
     "map": {
      "cases": [
       {
        "equals": "running",
        "to": 1
       }
      ],
      "else": 0
     }
    },
    {
     "input": "stage.3",
     "target": "state:stage-3-lamp"
    },
    {
     "input": "stage.3",
     "target": "animation:stage-3-spinner",
     "map": {
      "cases": [
       {
        "equals": "running",
        "to": 1
       }
      ],
      "else": 0
     }
    },
    {
     "input": "stage.4",
     "target": "state:stage-4-lamp"
    },
    {
     "input": "stage.4",
     "target": "animation:stage-4-spinner",
     "map": {
      "cases": [
       {
        "equals": "running",
        "to": 1
       }
      ],
      "else": 0
     }
    },
    {
     "input": "jobStarted",
     "target": "spawn:item-spawn"
    },
    {
     "input": "jobPassed",
     "target": "effect:success-fx"
    },
    {
     "input": "jobFailed",
     "target": "spawn:reject-in"
    },
    {
     "input": "jobFailed",
     "target": "effect:fail-fx"
    },
    {
     "input": "progress",
     "target": "count:progress",
     "map": {
      "scale": {
       "from": [
        0,
        1
       ],
       "to": [
        0,
        10
       ]
      },
      "clamp": true,
      "round": "floor"
     }
    },
    {
     "input": "queued",
     "target": "count:waiting"
    },
    {
     "input": "pipeline",
     "target": "label:label-title"
    }
   ],
   "recipes": [
    {
     "name": "Pipeline summary JSON",
     "fields": {
      "stage.1": "/stages/0/status",
      "stage.2": "/stages/1/status",
      "stage.3": "/stages/2/status",
      "stage.4": "/stages/3/status",
      "jobStarted": "/counters/started",
      "jobPassed": "/counters/passed",
      "jobFailed": "/counters/failed",
      "progress": "/progress",
      "queued": {
       "countWhere": {
        "array": "/jobs",
        "pointer": "/status",
        "equals": "queued"
       }
      },
      "pipeline": "/name"
     }
    }
   ]
  }
 },
